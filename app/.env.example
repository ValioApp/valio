# VALIO — variables de entorno de la app (app/.env.local)
# Copia este archivo a `app/.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` al repo (está en .gitignore).

# --- Supabase (cliente + servidor) ---------------------------------------
# Proyecto Supabase de VALIO. Se exponen al navegador (prefijo NEXT_PUBLIC_):
# la anon key es pública por diseño y la seguridad la garantiza el RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- URL pública de la app -----------------------------------------------
# Base para los enlaces de auth que viajan por email (magic link, confirmación
# de registro, recuperación de contraseña). En desarrollo puede omitirse
# (cae a http://localhost:3000). En PRODUCCIÓN es OBLIGATORIA: fíjala en Vercel
# a la URL real de despliegue; si falta, la app lanza un error en runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo para scripts/migraciones (server-side, NUNCA en el navegador) ---
# No llevan prefijo NEXT_PUBLIC_. Se usan por los ETLs (npm run etl:*) y por
# la aplicación de migraciones vía Management API. La app en runtime NO los usa.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
